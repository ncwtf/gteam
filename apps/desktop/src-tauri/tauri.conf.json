{
  "$schema": "https://schema.tauri.app/config/2.0",
  "productName": "gteam",
  "version": "0.1.0",
  "identifier": "com.gteam.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "app": {
    "windows": [
      {
        "title": "gteam",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "notification": {
      "all": true,
      "show": true
    },
    "shell": {
      "all": false,
      "open": true
    },
    "store": {
      "all": true
    },
    "fs": {
      "scope": ["$APPDATA/*", "$HOME/.gteam/*"]
    },
    "dialog": {
      "all": true
    }
  }
}

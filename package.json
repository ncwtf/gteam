{
  "name": "gteam",
  "version": "0.1.0",
  "private": true,
  "description": "gteam (God Team): AI-first team context hub - desktop app + MCP server + sync service",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "pnpm --filter @gteam/server dev",
    "dev:desktop": "pnpm --filter @gteam/desktop dev",
    "dev:mcp": "pnpm --filter @gteam/mcp-server dev",
    "build": "pnpm -r build",
    "bundle:mcp": "node scripts/bundle-mcp-sidecar.mjs",
    "test": "pnpm -r test && node --test scripts/bundle-mcp-sidecar.test.mjs .github/scripts/release-notes.test.mjs && bash scripts/install.test.sh",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "postject": "1.0.0-alpha.6"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}
